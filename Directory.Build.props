<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.5.4</Version>
    <Authors>Langkurst</Authors>
    <Company>KeaClip</Company>
    <!-- Every shipped file says KeaClip (code-signing services check the product name and version). -->
    <Product>KeaClip</Product>
    <Copyright>Copyright (C) 2026 Langkurst</Copyright>
    <NuGetAudit>true</NuGetAudit>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Public (default) or Personal. Only Personal builds include watch links, which upload to the owner's own
         Cloudflare storage; public copies share through File.Kiwi only, so nobody else can use that storage. -->
    <KeaClipEdition Condition="'$(KeaClipEdition)' == ''">Public</KeaClipEdition>
    <DefineConstants Condition="'$(KeaClipEdition)' == 'Personal'">$(DefineConstants);KEACLIP_PERSONAL</DefineConstants>
    <!-- Beta builds (handed to testers before a release) add the in-app Beta test checklist and report. -->
    <KeaClipBeta Condition="'$(KeaClipBeta)' == ''">false</KeaClipBeta>
    <DefineConstants Condition="'$(KeaClipBeta)' == 'true'">$(DefineConstants);KEACLIP_BETA</DefineConstants>
  </PropertyGroup>
</Project>
