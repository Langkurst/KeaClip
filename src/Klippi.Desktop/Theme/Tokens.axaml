<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Design tokens. App surfaces use the App* keys; Fluent keys are retinted
       here so stock controls (sliders, toggles, menus) share one palette. -->
