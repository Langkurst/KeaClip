      <SolidColorBrush x:Key="ExpanderHeaderBackground">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver">#F3F0E7</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed">#EAE6DB</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrush">#E2DDCF</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver">#CDC7B5</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed">#CDC7B5</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderContentBackground">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderContentBorderBrush">#E2DDCF</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderChevronForeground">#575548</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderChevronBackground">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="ExpanderChevronBorderBrush">Transparent</SolidColorBrush>
      <SolidColorBrush x:Key="ToolTipBackground">#26251D</SolidColorBrush>
      <SolidColorBrush x:Key="ToolTipBorderBrush">#26251D</SolidColorBrush>
      <SolidColorBrush x:Key="ToolTipForeground">#F5F3EC</SolidColorBrush>
      <SolidColorBrush x:Key="FlyoutPresenterBackground">#FAF8F2</SolidColorBrush>
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush">#CDC7B5</SolidColorBrush>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground">#FAF8F2</SolidColorBrush>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush">#CDC7B5</SolidColorBrush>
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver">#F0EDE3</SolidColorBrush>
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed">#E7E3D7</SolidColorBrush>
      <Color x:Key="SystemAccentColor">#5A6A16</Color>
      <Color x:Key="SystemAccentColorDark1">#4C5A11</Color>
      <Color x:Key="SystemAccentColorLight1">#6E8020</Color>
      <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver">#A6A391</SolidColorBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Headings and the wordmark: Bricolage Grotesque (OFL, Assets/Fonts). Body text: Windows 11's own Segoe UI Variable,
       so KeaClip reads as a native Windows app (Segoe UI on Windows 10; the bundled Inter only as a last resort). -->
  <FontFamily x:Key="DisplayFont">avares://KeaClip/Assets/Fonts#Bricolage Grotesque, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="RadiusCard">10</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <!-- Tags are crisp, not pills. -->
  <CornerRadius x:Key="RadiusChip">5</CornerRadius>
  <x:Double x:Key="TextControlThemeMinHeight">40</x:Double>
</ResourceDictionary>
