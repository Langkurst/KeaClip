<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:Klippi.Desktop.Controls" x:Class="Klippi.Desktop.Views.BetaTestView">
  <UserControl.Styles>
    <!-- Works / Problem answers: quiet until chosen, then olive (works) or the danger colour (problem). -->
    <Style Selector="Button.verdict"><Setter Property="MinWidth" Value="96" /><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.verdict.works.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}" />
    </Style>
    <Style Selector="Button.verdict.works.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppAccentSubtleText}" /></Style>
    <Style Selector="Button.verdict.works.selected c|StrokeIcon"><Setter Property="Foreground" Value="{DynamicResource AppAccent}" /></Style>
    <Style Selector="Button.verdict.problem.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppDangerSubtle}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDanger}" />
    </Style>
    <Style Selector="Button.verdict.problem.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppDanger}" /></Style>
    <Style Selector="Button.verdict.problem.selected c|StrokeIcon"><Setter Property="Foreground" Value="{DynamicResource AppDanger}" /></Style>
    <Style Selector="Border.step-number">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Name="BetaScroll" HorizontalScrollBarVisibility="Disabled" Padding="36,4,36,28">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100000*" MaxWidth="1040" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Spacing="18">

        <!-- ===== What to try ===== -->
        <Border Name="BetaChecksCard" Classes="card enter e1"><StackPanel Spacing="18">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Classes="well large" VerticalAlignment="Center"><c:StrokeIcon Data="{StaticResource IconSparkle}" /></Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Thanks for testing KeaClip" Classes="section" />
              <TextBlock Text="Try these in order and mark each one. About ten minutes. Something broken is just as useful as something that works." Classes="caption muted" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="2" Classes="chip accent" Padding="9,3" VerticalAlignment="Center">
              <TextBlock Name="BetaProgressText" Text="{Binding BetaProgress}" FontSize="12" FontWeight="SemiBold" Classes="tabular" />
            </Border>
          </Grid>
          <ItemsControl Name="BetaChecksList" ItemsSource="{Binding BetaChecks}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                  <Border Classes="step-number"><TextBlock Text="{Binding Number}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AppAccentSubtleText}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Hint}" Classes="caption muted" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="small verdict works" Classes.selected="{Binding Works}" Command="{Binding MarkWorksCommand}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: works'}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><c:StrokeIcon Data="{StaticResource IconCheck}" Size="14" /><TextBlock Text="Works" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="small verdict problem" Classes.selected="{Binding Problem}" Command="{Binding MarkProblemCommand}" AutomationProperties.Name="{Binding Title, StringFormat='{}{0}: problem'}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><c:StrokeIcon Data="{StaticResource IconAlert}" Size="14" /><TextBlock Text="Problem" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel></Border>

        <!-- ===== Notes ===== -->
        <Border Name="BetaNotesCard" Classes="card enter e2"><StackPanel Spacing="12">
          <TextBlock Text="What happened?" Classes="section" />
          <TextBox Name="BetaNotesBox" Text="{Binding BetaNotes, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" VerticalContentAlignment="Top" PlaceholderText="What went wrong, what was confusing, what you liked. Anything helps." AutomationProperties.Name="Beta test notes" />
        </StackPanel></Border>

        <!-- ===== Send ===== -->
        <Border Name="BetaSendCard" Classes="card enter e3"><StackPanel Spacing="14">
          <StackPanel Spacing="4">
            <TextBlock Text="Send your report" Classes="section" />
            <TextBlock Classes="caption muted" TextWrapping="Wrap" Text="Save report puts a small text file on your Desktop with your answers, your notes, your Windows version and screen scaling, and the last error KeaClip hit. Folder names and links are taken out. Open it to see exactly what is in it, then email it to the address below." />
          </StackPanel>
          <WrapPanel ItemSpacing="10" LineSpacing="10">
            <Button Name="SaveBetaReportButton" Classes="primary cta" Command="{Binding SaveBetaReportCommand}" AutomationProperties.Name="Save report">
              <StackPanel Orientation="Horizontal" Spacing="8"><c:StrokeIcon Data="{StaticResource IconFile}" Size="16" /><TextBlock Text="Save report" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button Name="ShowBetaReportButton" Command="{Binding ShowBetaReportCommand}" IsVisible="{Binding HasBetaReport}" AutomationProperties.Name="Show report">
              <StackPanel Orientation="Horizontal" Spacing="8"><c:StrokeIcon Data="{StaticResource IconFolder}" Size="16" /><TextBlock Text="Show report" VerticalAlignment="Center" /></StackPanel>
            </Button>
            <Button Name="CopyContactButton" Command="{Binding CopyContactEmailCommand}" ToolTip.Tip="Copy the email address" AutomationProperties.Name="Copy email address">
              <StackPanel Orientation="Horizontal" Spacing="8"><c:StrokeIcon Data="{StaticResource IconCopy}" Size="16" /><TextBlock Text="{Binding ContactEmail}" VerticalAlignment="Center" /></StackPanel>
            </Button>
          </WrapPanel>
          <TextBlock Name="BetaReportSavedText" Text="{Binding BetaReportSaved}" IsVisible="{Binding HasBetaReport}" Classes="caption muted" TextWrapping="Wrap" />
        </StackPanel></Border>

      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
