<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Klippi.Desktop" x:Class="Klippi.Desktop.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://KeaClip/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://KeaClip/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:ChoiceLabelConverter x:Key="ChoiceLabel" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://KeaClip/Theme/Controls.axaml" />
  </Application.Styles>
</Application>
