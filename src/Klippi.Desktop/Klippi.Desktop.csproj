<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>KeaClip</AssemblyName>
    <ApplicationIcon>Assets/kea.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Klippi.Core/Klippi.Core.csproj" />
    <ProjectReference Include="../Klippi.Infrastructure/Klippi.Infrastructure.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
  <ItemGroup><AvaloniaResource Include="Assets/**" /></ItemGroup>
  <!-- The preview only plays local files, so VLC's network access, streaming-out, encoders, scripting, subtitle/OSD
       rendering and other unused plugins are left out (about half of VLC's size). Checked by the native playback tests
       (KEACLIP_NATIVE_PLAYBACK_TESTS=1) and Klippi.PackageChecks. -->
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="plugins\access_output\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_out\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\mux\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\services_discovery\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\visualization\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\lua\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\keystore\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\video_splitter\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\meta_engine\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\text_renderer\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\spu\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\stream_extractor\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\logger\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="lua\%2A%2A" />
    <VlcWindowsX64ExcludeFiles Include="plugins\access\libaccess_mms_plugin.dll" />
