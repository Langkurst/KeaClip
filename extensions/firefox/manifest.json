{
  "manifest_version": 2,
  "name": "Send to KeaClip",
  "version": "0.1.0",
  "description": "Send a selected media link to your local KeaClip app. Downloads start only in the app.",
  "permissions": ["contextMenus", "activeTab"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Open in KeaClip" },
  "browser_specific_settings": { "gecko": { "id": "keaclip-local@langkurst", "strict_min_version": "109.0" } }
}
